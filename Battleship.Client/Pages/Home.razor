@page "/"
@using Battleship.Client.Services
@inject NavigationManager Navigation
@inject GameHubService HubService

<div class="home-container">
    <h2 class="home-title">🚢 Battleship Online</h2>
    <p class="home-subtitle">Classic naval combat — play with a friend online</p>

    @if (!isConnected)
    {
        <div class="menu-card">
            <p class="connecting-text"><em>Connecting to game server...</em></p>
        </div>
    }
    else
    {
        <div class="menu-card">
            <h4>Create a New Game</h4>
            <p class="card-desc">Start a new room and share the invite link or code with your friend.</p>
            <button class="btn btn-primary" @onclick="CreateGame">
                ➕ Create Room
            </button>
        </div>

        <div class="menu-card">
            <h4>Join a Game</h4>
            <p class="card-desc">Enter a 6-character room code to join an existing match.</p>
            <div class="join-row">
                <input class="room-input"
                       @bind="inputRoomCode"
                       placeholder="e.g. 2B6A13"
                       maxlength="6" />
                <button class="btn btn-success" @onclick="JoinGame">
                    🚀 Join
                </button>
            </div>
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <p class="error-text">@errorMessage</p>
            }
        </div>
    }
</div>

<style>
    .home-container {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        max-width: 480px;
        margin: 50px auto;
        padding: 0 16px;
        text-align: center;
        color: #0f172a;
    }

    .home-title {
        font-size: 30px;
        font-weight: 700;
        margin-bottom: 6px;
        color: #0f172a;
    }

    .home-subtitle {
        font-size: 14px;
        color: #64748b;
        margin-bottom: 28px;
    }

    .menu-card {
        background-color: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        padding: 22px;
        margin-bottom: 20px;
    }

    .menu-card h4 {
        margin: 0 0 6px 0;
        font-size: 18px;
        color: #0f172a;
    }

    .card-desc {
        font-size: 13px;
        color: #475569;
        margin: 0 0 16px 0;
    }

    .connecting-text {
        margin: 0;
        color: #0284c7;
        font-size: 15px;
    }

    .join-row {
        display: flex;
        justify-content: center;
        gap: 10px;
        flex-wrap: wrap;
    }

    .room-input {
        padding: 8px 12px;
        font-size: 15px;
        font-weight: 600;
        letter-spacing: 2px;
        text-transform: uppercase;
        text-align: center;
        border: 2px solid #cbd5e1;
        border-radius: 6px;
        background-color: #ffffff;
        color: #0f172a;
        width: 160px;
        outline: none;
        transition: border-color 0.15s;
    }

        .room-input:focus {
            border-color: #0284c7;
        }

    .btn {
        padding: 9px 18px;
        border: none;
        border-radius: 6px;
        cursor: pointer;
        font-size: 15px;
        font-weight: 500;
        transition: background-color 0.15s, opacity 0.15s;
    }

    .btn-primary {
        background-color: #0284c7;
        color: white;
    }

        .btn-primary:hover {
            background-color: #0369a1;
        }

    .btn-success {
        background-color: #16a34a;
        color: white;
    }

        .btn-success:hover {
            background-color: #15803d;
        }

    .error-text {
        color: #dc2626;
        font-size: 14px;
        margin: 12px 0 0 0;
    }
</style>

@code {
    private bool isConnected = false;
    private string inputRoomCode = "";
    private string errorMessage = "";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await HubService.StartConnectionAsync("https://battleship-server-api-h7bzc9e0excrcned.polandcentral-01.azurewebsites.net/gamehub");
            isConnected = true;
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to connect to server: {ex.Message}";
        }
    }

    private async Task CreateGame()
    {
        var code = await HubService.CreateRoomAsync();
        Navigation.NavigateTo($"/game/{code}?host=true");
    }

    private async Task JoinGame()
    {
        if (string.IsNullOrWhiteSpace(inputRoomCode))
        {
            errorMessage = "Please enter a room code!";
            return;
        }

        bool success = await HubService.JoinRoomAsync(inputRoomCode);
        if (success)
        {
            Navigation.NavigateTo($"/game/{inputRoomCode.ToUpper()}?host=false");
        }
        else
        {
            errorMessage = "Room not found or already full!";
        }
    }
}
