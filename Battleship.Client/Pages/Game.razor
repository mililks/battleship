@page "/game/{RoomCode}"
@inject global::Battleship.Client.Services.GameHubService HubService
@inject NavigationManager Navigation
@inject IJSRuntime JS

@implements IDisposable

<div class="game-container">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px;">
        <button class="btn btn-secondary" @onclick="LeaveGame">
            ⬅️ До головного меню
        </button>
        <div>
            <h2>Кімната: <span class="badge">@RoomCode</span></h2>
            @if (Host && !isBattleStarted)
            {
                <button class="btn btn-primary" style="margin-top: 5px; font-size: 13px;" @onclick="CopyInviteLink">
                    📋 @copyButtonText
                </button>
            }
        </div>
        <div style="width: 140px;"></div>
    </div>

    <h4 class="status-banner">@statusMessage</h4>


    <!-- Фаза 1: Очікування гравців та розстановка -->
    @if (!isBattleStarted)
    {
        <div class="placement-panel">
            <button class="btn btn-primary" @onclick="RandomizeFleet" disabled="@isReady">
                🔀 Випадкова розстановка
            </button>
            <button class="btn btn-warning" @onclick="ClearFleet" disabled="@isReady">
                🗑️ Очистити поле
            </button>
            <button class="btn btn-info" @onclick="ToggleOrientation" disabled="@isReady">
                🔄 @(selectedOrientation == ShipOrientation.Horizontal ? "Горизонтально (➡️)" : "Вертикально (⬇️)")
            </button>
            <button class="btn btn-success" @onclick="ConfirmReady" disabled="@(isReady || !myBoard.IsFleetComplete())">
                @(isReady ? "Очікування суперника..." : "Готовий до бою!")
            </button>
        </div>

        <div class="shipyard-panel">
            <span class="shipyard-title">Оберіть корабель для встановлення (клік по встановленому кораблю на полі — прибрати):</span>
            <div class="shipyard-buttons">
                @foreach (var size in new[] { 4, 3, 2, 1 })
                {
                    int remaining = GetRemainingShips(size);
                    bool isSelected = selectedShipSize == size && remaining > 0;
                    <button class="ship-select-btn @(isSelected ? "selected" : "")"
                            disabled="@(isReady || remaining == 0)"
                            @onclick="() => SelectShipSize(size)">
                        <span class="ship-preview">@(new string('■', size))</span>
                        <span>(@remaining шт.)</span>
                    </button>
                }
            </div>
        </div>
    }

    <!-- Фаза 2: Сітки полів -->
    <div class="boards-layout">
        <!-- Власне поле -->
        <div class="board-wrapper">
            <h3>Ваш флот (@myBoard.Ships.Count / 10)</h3>
            <div class="ocean-grid" @onmouseleave="ClearHover">
                @for (int y = 0; y < 10; y++)
                {
                    @for (int x = 0; x < 10; x++)
                    {
                        int cellX = x;
                        int cellY = y;
                        var cellState = myBoard.GetCellState(cellX, cellY);
                        var previewClass = GetPreviewCssClass(cellX, cellY);
                        <div class="grid-cell @GetCellCssClass(cellState, isOwnBoard: true) @previewClass @(!isBattleStarted && !isReady ? "placement-cell" : "")"
                             @onclick="() => OnOwnBoardClick(cellX, cellY)"
                             @onmouseenter="() => OnOwnBoardHover(cellX, cellY)">
                            @GetCellSymbol(cellState, isOwnBoard: true)
                        </div>
                    }
                }
            </div>
        </div>

        <!-- Поле суперника -->
        <div class="board-wrapper">
            <h3>Поле суперника</h3>
            <div class="ocean-grid">
                @for (int y = 0; y < 10; y++)
                {
                    @for (int x = 0; x < 10; x++)
                    {
                        int targetX = x;
                        int targetY = y;
                        var cellState = trackingGrid[targetX, targetY];
                        <button class="grid-cell target-cell @GetCellCssClass(cellState, isOwnBoard: false)"
                                disabled="@(!isMyTurn || !isBattleStarted || cellState != CellState.Empty)"
                                @onclick="() => MakeShot(targetX, targetY)">
                            @GetCellSymbol(cellState, isOwnBoard: false)
                        </button>
                    }
                }
            </div>
        </div>
    </div>
</div>

<style>
    .game-container {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        text-align: center;
        margin: 20px auto;
        max-width: 900px;
    }

    .badge {
        background-color: #0284c7;
        color: white;
        padding: 3px 8px;
        border-radius: 4px;
    }

    .status-banner {
        color: #0f172a;
        margin: 15px 0;
        min-height: 28px;
    }

    .placement-panel {
        margin: 15px 0 10px 0;
        display: flex;
        justify-content: center;
        flex-wrap: wrap;
        gap: 10px;
    }

    .shipyard-panel {
        background-color: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        padding: 10px 15px;
        margin: 0 auto 15px auto;
        max-width: 680px;
    }

    .shipyard-title {
        display: block;
        font-size: 13px;
        color: #475569;
        margin-bottom: 8px;
    }

    .shipyard-buttons {
        display: flex;
        justify-content: center;
        flex-wrap: wrap;
        gap: 10px;
    }

    .ship-select-btn {
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 6px 12px;
        border: 2px solid #cbd5e1;
        border-radius: 6px;
        background-color: white;
        cursor: pointer;
        font-size: 14px;
        transition: all 0.15s;
    }

        .ship-select-btn.selected {
            border-color: #0284c7;
            background-color: #e0f2fe;
            font-weight: bold;
        }

        .ship-select-btn:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }

    .ship-preview {
        color: #475569;
        letter-spacing: 2px;
    }

    .btn {
        padding: 8px 16px;
        border: none;
        border-radius: 6px;
        cursor: pointer;
        font-size: 15px;
    }

        .btn:disabled {
            opacity: 0.6;
            cursor: not-allowed;
        }

    .btn-primary {
        background-color: #0284c7;
        color: white;
    }

    .btn-warning {
        background-color: #eab308;
        color: white;
    }

    .btn-info {
        background-color: #0ea5e9;
        color: white;
    }

    .btn-success {
        background-color: #16a34a;
        color: white;
    }

    .boards-layout {
        display: flex;
        justify-content: center;
        gap: 40px;
        flex-wrap: wrap;
        margin-top: 15px;
    }

    .board-wrapper {
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .ocean-grid {
        display: grid;
        grid-template-columns: repeat(10, 32px);
        grid-template-rows: repeat(10, 32px);
        gap: 2px;
        background-color: #cbd5e1;
        padding: 4px;
        border-radius: 4px;
    }

    .grid-cell {
        width: 32px;
        height: 32px;
        background-color: #f0f9ff;
        border: 1px solid #bae6fd;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        font-size: 16px;
        box-sizing: border-box;
        user-select: none;
    }

    .placement-cell {
        cursor: pointer;
    }

    .preview-valid {
        background-color: #86efac !important;
        border-color: #22c55e !important;
    }

    .preview-invalid {
        background-color: #fca5a5 !important;
        border-color: #ef4444 !important;
    }

    .btn-secondary {
        background-color: #64748b;
        color: white;
    }

        .btn-secondary:hover {
            background-color: #475569;
        }

    .target-cell {
        cursor: pointer;
    }

        .target-cell:disabled {
            cursor: default;
        }
    /* Кольори статусів клітинок */
    .cell-ship {
        background-color: #475569;
        color: #fff;
    }
    /* Власний корабель */
    .cell-hit {
        background-color: #ef4444;
        color: #fff;
    }
    /* Влучання (червоний) */
    .cell-miss {
        background-color: #94a3b8;
        color: #334155;
    }
    /* Промах (сіра точка) */
</style>

@code {
    [Parameter] public string RoomCode { get; set; } = string.Empty;
    [SupplyParameterFromQuery] public bool Host { get; set; }

    private Board myBoard = new();
    private CellState[,] trackingGrid = new CellState[10, 10]; // Поле відстеження пострілів

    private bool isReady = false;
    private bool isBattleStarted = false;
    private bool isMyTurn = false;
    private string statusMessage = "Розставте флот і натисніть «Готовий до бою»";
    private string copyButtonText = "Скопіювати запрошення";

    // Ручна розстановка кораблів
    private static readonly Dictionary<int, int> MaxShipsBySize = new()
    {
        { 4, 1 },
        { 3, 2 },
        { 2, 3 },
        { 1, 4 }
    };
    private int? selectedShipSize = 4;
    private ShipOrientation selectedOrientation = ShipOrientation.Horizontal;
    private Point? hoverPoint = null;

    private async Task LeaveGame()    
    {
        // Сповіщаємо сервер про вихід з кімнати
        await HubService.LeaveRoomAsync(RoomCode);

        // Перенаправляємо гравця назад на головну сторінку
        Navigation.NavigateTo("/");
    }
    protected override async Task OnInitializedAsync()
    {
        myBoard.PlaceFleetRandomly();
        AutoSelectNextShipSize();

        // 1. Перевіряємо, чи підключений клієнт до SignalR (критично при переході за URL)
        if (!HubService.IsConnected)
        {
            try
            {
                await HubService.StartConnectionAsync("https://battleship-server-api-h7bzc9e0excrcned.polandcentral-01.azurewebsites.net/gamehub");
            }
            catch (Exception ex)
            {
                statusMessage = $"Помилка з'єднання: {ex.Message}";
                return;
            }
        }

        // 2. Підписуємося на події
        HubService.OnPlayerJoined += HandlePlayerJoined;
        HubService.OnGameStarted += HandleGameStarted;
        HubService.OnShotResultReceived += HandleShotResult;
        HubService.OnOpponentDisconnected += HandleOpponentDisconnected;

        // 3. Якщо зайшов гість за посиланням — автоматично приєднуємося до кімнати на сервері!
        if (!Host)
        {
            statusMessage = "Приєднання до кімнати...";
            bool joined = await HubService.JoinRoomAsync(RoomCode);
            if (joined)
            {
                statusMessage = "Ви підключилися! Розставте флот і підтвердіть готовність.";
            }
            else
            {
                statusMessage = "Не вдалося зайти (кімната не існує або заповнена).";
            }
        }
        else
        {
            statusMessage = "Поділіться посиланням із другом та підтвердіть готовність.";
        }
    }
    private async Task CopyInviteLink()
    {
        // Формуємо чисте посилання для другого гравця БЕЗ ?host=true
        var uri = new Uri(Navigation.Uri);
        var baseAddress = uri.GetLeftPart(UriPartial.Path); // отримує http://localhost:7091/game/CODE
        await JS.InvokeVoidAsync("copyToClipboard", baseAddress);

        copyButtonText = "✅ Посилання скопійовано!";
        await Task.Delay(2500);
        copyButtonText = "Скопіювати запрошення";
        StateHasChanged();
    }

    private int GetRemainingShips(int size)
    {
        int placed = myBoard.Ships.Count(s => s.Size == size);
        return Math.Max(0, MaxShipsBySize[size] - placed);
    }

    private void AutoSelectNextShipSize()
    {
        if (selectedShipSize.HasValue && GetRemainingShips(selectedShipSize.Value) > 0)
            return;

        foreach (var size in new[] { 4, 3, 2, 1 })
        {
            if (GetRemainingShips(size) > 0)
            {
                selectedShipSize = size;
                return;
            }
        }
        selectedShipSize = null;
    }

    private void SelectShipSize(int size)
    {
        if (GetRemainingShips(size) > 0)
        {
            selectedShipSize = size;
        }
    }

    private void ToggleOrientation()
    {
        selectedOrientation = selectedOrientation == ShipOrientation.Horizontal
            ? ShipOrientation.Vertical
            : ShipOrientation.Horizontal;
    }

    private void ClearFleet()
    {
        if (isReady || isBattleStarted) return;
        myBoard.Clear();
        selectedShipSize = 4;
        statusMessage = "Поле очищено. Виставте кораблі на поле.";
    }

    private void RandomizeFleet()
    {
        if (isReady || isBattleStarted) return;
        myBoard.PlaceFleetRandomly();
        AutoSelectNextShipSize();
        statusMessage = "Флот розставлено випадковим чином.";
        StateHasChanged();
    }

    private void OnOwnBoardHover(int x, int y)
    {
        if (isReady || isBattleStarted) return;
        hoverPoint = new Point(x, y);
    }

    private void ClearHover()
    {
        hoverPoint = null;
    }

    private string GetPreviewCssClass(int x, int y)
    {
        if (isReady || isBattleStarted || hoverPoint == null || !selectedShipSize.HasValue)
            return "";

        int size = selectedShipSize.Value;
        if (GetRemainingShips(size) <= 0)
            return "";

        bool isValid = myBoard.CanPlaceShip(size, hoverPoint, selectedOrientation, out var pts);

        // Перевіряємо, чи входить клітинка (x, y) до проєкції корабля від hoverPoint
        bool inFootprint = false;
        for (int i = 0; i < size; i++)
        {
            int cx = selectedOrientation == ShipOrientation.Horizontal ? hoverPoint.X + i : hoverPoint.X;
            int cy = selectedOrientation == ShipOrientation.Vertical ? hoverPoint.Y + i : hoverPoint.Y;
            if (cx == x && cy == y)
            {
                inFootprint = true;
                break;
            }
        }

        if (!inFootprint) return "";
        return isValid ? "preview-valid" : "preview-invalid";
    }

    private void OnOwnBoardClick(int x, int y)
    {
        if (isReady || isBattleStarted) return;

        var clickedPt = new Point(x, y);

        // Якщо клікнули по вже встановленому кораблю — прибираємо його, щоб можна було переставити
        if (myBoard.GetCellState(x, y) == CellState.Ship)
        {
            var removed = myBoard.RemoveShipAt(clickedPt);
            if (removed != null)
            {
                selectedShipSize = removed.Size;
                selectedOrientation = removed.Orientation;
                statusMessage = $"Прибрано: {removed.Name}. Оберіть нову позицію.";
            }
            return;
        }

        // Інакше пробуємо поставити обраний корабель
        if (!selectedShipSize.HasValue || GetRemainingShips(selectedShipSize.Value) <= 0)
        {
            AutoSelectNextShipSize();
            if (!selectedShipSize.HasValue)
            {
                statusMessage = "Усі кораблі вже виставлено! Натисніть «Готовий до бою!» або клікніть по кораблю, щоб переставити.";
                return;
            }
        }

        var ship = Board.CreateShipBySize(selectedShipSize.Value);
        if (myBoard.TryPlaceShip(ship, clickedPt, selectedOrientation))
        {
            AutoSelectNextShipSize();
            statusMessage = myBoard.IsFleetComplete()
                ? "Усі кораблі розставлено! Натисніть «Готовий до бою!»."
                : $"Встановлено: {ship.Name}. Залишилося кораблів: {10 - myBoard.Ships.Count}.";
        }
        else
        {
            statusMessage = "Неможливо поставити корабель тут (вихід за межі або дотик до іншого корабля).";
        }
    }

    private async Task ConfirmReady()
    {
        if (!myBoard.IsFleetComplete())
        {
            statusMessage = "Спочатку виставте всі 10 кораблів!";
            return;
        }
        isReady = true;
        hoverPoint = null;
        statusMessage = "Очікування готовності суперника...";
        var points = myBoard.GetAllOccupiedPoints();
        await HubService.SetReadyAsync(RoomCode, points);
    }

    private void HandlePlayerJoined(string code)
    {
        statusMessage = "Суперник підключився до кімнати!";
        InvokeAsync(StateHasChanged);
    }

    private void HandleGameStarted(string firstTurnConnectionId)
    {
        isBattleStarted = true;
       
        isMyTurn = Host;
        statusMessage = isMyTurn ? "Бій розпочато! Ваш перший хід!" : "Бій розпочато! Хід супротивника...";
        InvokeAsync(StateHasChanged);
    }

    private async Task MakeShot(int x, int y)
    {
        if (!isMyTurn) return;
        await HubService.SendShotAsync(RoomCode, new Point(x, y));
    }

    private void HandleShotResult(ShotResultDto result)
    {
        // Оновлюємо мапу пострілів або власну дошку
        var pt = result.Target;

        if (isMyTurn)
        {
            // Це був наш постріл
            trackingGrid[pt.X, pt.Y] = result.IsHit ? CellState.Hit : CellState.Miss;

            // Якщо корабель затоплено — виділяємо всі його координати як Hit,
            // а всі сусідні координати навколо нього автоматично позначаємо як Miss (промах)
            if (result.IsSunk && result.SunkShipCoordinates != null)
            {
                foreach (var shipPt in result.SunkShipCoordinates)
                {
                    trackingGrid[shipPt.X, shipPt.Y] = CellState.Hit;
                }

                var surrounding = Board.GetSurroundingCoordinates(result.SunkShipCoordinates);
                foreach (var sPt in surrounding)
                {
                    if (trackingGrid[sPt.X, sPt.Y] == CellState.Empty)
                    {
                        trackingGrid[sPt.X, sPt.Y] = CellState.Miss;
                    }
                }
            }

            if (result.IsGameOver)
            {
                statusMessage = "🏆 Вітаємо! Ви знищили весь ворожий флот і перемогли!";
                isMyTurn = false;
            }
            else
            {
                isMyTurn = result.IsHit; // Якщо влучив — стріляєш знову, якщо промах — хід переходить
                statusMessage = result.IsHit
                    ? (result.IsSunk ? $"🔥 Затоплено: {result.SunkShipName ?? "корабель"}! Стріляйте ще раз." : "🎯 Влучання! Стріляйте ще раз.")
                    : "🌊 Промах. Хід перейшов до суперника.";
            }
        }
        else
        {
            // Це стріляв суперник по нашій дошці (обробляємо і влучання, і промахи):
            myBoard.ProcessShot(pt);

            if (result.IsGameOver)
            {
                statusMessage = "💀 Ваш флот знищено. Поразка.";
                isMyTurn = false;
            }
            else
            {
                isMyTurn = !result.IsHit;
                statusMessage = result.IsHit
                    ? (result.IsSunk ? $"💥 Суперник затопив ваш {result.SunkShipName ?? "корабель"}!" : "💥 Суперник влучив у ваш корабель!")
                    : "🛡️ Суперник промахнувся. Ваш хід!";
            }
        }

        InvokeAsync(StateHasChanged);
    }

    private void HandleOpponentDisconnected()
    {
        statusMessage = "Суперник вийшов із гри. Партію завершено.";
        isBattleStarted = false;
        InvokeAsync(StateHasChanged);
    }

    private string GetCellCssClass(CellState state, bool isOwnBoard) => state switch
    {
        CellState.Ship when isOwnBoard => "cell-ship",
        CellState.Hit => "cell-hit",
        CellState.Miss => "cell-miss",
        _ => ""
    };

    private string GetCellSymbol(CellState state, bool isOwnBoard) => state switch
    {
        CellState.Ship when isOwnBoard => "■",
        CellState.Hit => "✕",
        CellState.Miss => "•",
        _ => ""
    };

    public void Dispose()
    {
        HubService.OnPlayerJoined -= HandlePlayerJoined;
        HubService.OnGameStarted -= HandleGameStarted;
        HubService.OnShotResultReceived -= HandleShotResult;
        HubService.OnOpponentDisconnected -= HandleOpponentDisconnected;
    }
}
