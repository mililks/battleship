@page "/game/{RoomCode}"
@inject global::Battleship.Client.Services.GameHubService HubService
@inject NavigationManager Navigation
@inject IJSRuntime JS

@implements IDisposable

<div class="game-container">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px;">
        <button class="btn btn-secondary" @onclick="LeaveGame">
            ⬅️ Back to Menu
        </button>
        <div>
            <h2>Room: <span class="badge">@RoomCode</span></h2>
            @if (Host && !isBattleStarted)
            {
                <button class="btn btn-primary" style="margin-top: 5px; font-size: 13px;" @onclick="CopyInviteLink">
                    📋 @copyButtonText
                </button>
            }
        </div>
        <div style="width: 140px;"></div>
    </div>

    <h4 class="status-banner">@statusMessage</h4>


    <!-- Phase 1: Waiting for players and ship placement -->
    @if (!isBattleStarted)
    {
        <div class="placement-panel">
            <button class="btn btn-primary" @onclick="RandomizeFleet" disabled="@isReady">
                🔀 Randomize Fleet
            </button>
            <button class="btn btn-warning" @onclick="ClearFleet" disabled="@isReady">
                🗑️ Clear Board
            </button>
            <button class="btn btn-info" @onclick="ToggleOrientation" disabled="@isReady">
                🔄 @(selectedOrientation == ShipOrientation.Horizontal ? "Horizontal (➡️)" : "Vertical (⬇️)")
            </button>
            <button class="btn btn-success" @onclick="ConfirmReady" disabled="@(isReady || !myBoard.IsFleetComplete())">
                @(isReady ? "Waiting for opponent..." : "Ready for Battle!")
            </button>
        </div>

        <div class="shipyard-panel">
            <span class="shipyard-title">Select a ship to place (click a placed ship on the board to remove it):</span>
            <div class="shipyard-buttons">
                @foreach (var size in new[] { 4, 3, 2, 1 })
                {
                    int remaining = GetRemainingShips(size);
                    bool isSelected = selectedShipSize == size && remaining > 0;
                    <button class="ship-select-btn @(isSelected ? "selected" : "")"
                            disabled="@(isReady || remaining == 0)"
                            @onclick="() => SelectShipSize(size)">
                        <span class="shipyard-sprite-box size-@size">
                            <img src="images/ships/ship@(size).png" alt="@size-tile ship" class="shipyard-sprite-img" />
                        </span>
                        <span>(@remaining left)</span>
                    </button>
                }
            </div>
        </div>
    }

    <!-- Phase 2: Game grids -->
    <div class="boards-layout">
        <!-- Own board -->
        <div class="board-wrapper">
            <h3>Your Fleet (@myBoard.Ships.Count / 10)</h3>
            <div class="ocean-grid" @onmouseleave="ClearHover">
                @for (int y = 0; y < 10; y++)
                {
                    @for (int x = 0; x < 10; x++)
                    {
                        int cellX = x;
                        int cellY = y;
                        var cellState = myBoard.GetCellState(cellX, cellY);
                        var previewClass = GetPreviewCssClass(cellX, cellY);
                        var segment = (cellState == CellState.Ship || cellState == CellState.Hit)
                            ? GetShipSegmentAt(cellX, cellY)
                            : null;
                        <div class="grid-cell @GetCellCssClass(cellState, isOwnBoard: true) @previewClass @(!isBattleStarted && !isReady ? "placement-cell" : "")"
                             @onclick="() => OnOwnBoardClick(cellX, cellY)"
                             @onmouseenter="() => OnOwnBoardHover(cellX, cellY)">
                            @if (segment is { } seg)
                            {
                                <div class="ship-sprite @(seg.ship.Orientation == ShipOrientation.Horizontal ? "horizontal" : "") @(cellState == CellState.Hit ? "damaged" : "")"
                                     style="@GetShipSpriteStyle(seg.ship, seg.segmentIndex)"></div>
                                @if (cellState == CellState.Hit)
                                {
                                    <span class="hit-cross">✕</span>
                                }
                            }
                            else
                            {
                                @GetCellSymbol(cellState, isOwnBoard: true)
                            }
                        </div>
                    }
                }
            </div>
        </div>

        <!-- Opponent board -->
        <div class="board-wrapper">
            <h3>Opponent's Board</h3>
            <div class="ocean-grid">
                @for (int y = 0; y < 10; y++)
                {
                    @for (int x = 0; x < 10; x++)
                    {
                        int targetX = x;
                        int targetY = y;
                        var cellState = trackingGrid[targetX, targetY];
                        <button class="grid-cell target-cell @GetCellCssClass(cellState, isOwnBoard: false)"
                                disabled="@(!isMyTurn || !isBattleStarted || cellState != CellState.Empty)"
                                @onclick="() => MakeShot(targetX, targetY)">
                            @GetCellSymbol(cellState, isOwnBoard: false)
                        </button>
                    }
                }
            </div>
        </div>
    </div>
</div>

<style>
    .game-container {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        text-align: center;
        margin: 20px auto;
        max-width: 900px;
    }

    .badge {
        background-color: #0284c7;
        color: white;
        padding: 3px 8px;
        border-radius: 4px;
    }

    .status-banner {
        color: #0f172a;
        margin: 15px 0;
        min-height: 28px;
    }

    .placement-panel {
        margin: 15px 0 10px 0;
        display: flex;
        justify-content: center;
        flex-wrap: wrap;
        gap: 10px;
    }

    .shipyard-panel {
        background-color: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        padding: 10px 15px;
        margin: 0 auto 15px auto;
        max-width: 680px;
    }

    .shipyard-title {
        display: block;
        font-size: 13px;
        color: #475569;
        margin-bottom: 8px;
    }

    .shipyard-buttons {
        display: flex;
        justify-content: center;
        flex-wrap: wrap;
        gap: 10px;
    }

    .ship-select-btn {
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 6px 12px;
        border: 2px solid #cbd5e1;
        border-radius: 6px;
        background-color: white;
        cursor: pointer;
        font-size: 14px;
        transition: all 0.15s;
    }

        .ship-select-btn.selected {
            border-color: #0284c7;
            background-color: #e0f2fe;
            font-weight: bold;
        }

        .ship-select-btn:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }

    .ship-preview {
        color: #475569;
        letter-spacing: 2px;
    }

    .btn {
        padding: 8px 16px;
        border: none;
        border-radius: 6px;
        cursor: pointer;
        font-size: 15px;
    }

        .btn:disabled {
            opacity: 0.6;
            cursor: not-allowed;
        }

    .btn-primary {
        background-color: #0284c7;
        color: white;
    }

    .btn-warning {
        background-color: #eab308;
        color: white;
    }

    .btn-info {
        background-color: #0ea5e9;
        color: white;
    }

    .btn-success {
        background-color: #16a34a;
        color: white;
    }

    .boards-layout {
        display: flex;
        justify-content: center;
        gap: 40px;
        flex-wrap: wrap;
        margin-top: 15px;
    }

    .board-wrapper {
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .ocean-grid {
        display: grid;
        grid-template-columns: repeat(10, 32px);
        grid-template-rows: repeat(10, 32px);
        gap: 2px;
        background-color: #cbd5e1;
        padding: 4px;
        border-radius: 4px;
    }

    .shipyard-sprite-box {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        height: 24px;
        overflow: hidden;
    }

    .shipyard-sprite-box.size-1 { width: 24px; }
    .shipyard-sprite-box.size-2 { width: 48px; }
    .shipyard-sprite-box.size-3 { width: 72px; }
    .shipyard-sprite-box.size-4 { width: 96px; }

    .shipyard-sprite-img {
        width: 22px;
        height: auto;
        image-rendering: pixelated;
        transform: rotate(-90deg);
    }

    .shipyard-sprite-box.size-1 .shipyard-sprite-img {
        transform: none;
    }

    .grid-cell {
        position: relative;
        width: 32px;
        height: 32px;
        background-color: #f0f9ff;
        border: 1px solid #bae6fd;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        font-size: 16px;
        box-sizing: border-box;
        user-select: none;
        overflow: hidden;
    }

    .ship-sprite {
        position: absolute;
        inset: 0;
        background-repeat: no-repeat;
        image-rendering: pixelated;
        pointer-events: none;
        z-index: 1;
    }

        .ship-sprite.horizontal {
            transform: rotate(-90deg);
        }

        .ship-sprite.damaged {
            filter: brightness(0.8);
        }

    .hit-cross {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #ef4444;
        font-size: 24px;
        font-weight: 900;
        line-height: 1;
        text-shadow: 0 0 3px #ffffff, 0 0 2px #000000;
        pointer-events: none;
        z-index: 2;
    }

    .placement-cell {
        cursor: pointer;
    }

    .preview-valid {
        background-color: #86efac !important;
        border-color: #22c55e !important;
    }

    .preview-invalid {
        background-color: #fca5a5 !important;
        border-color: #ef4444 !important;
    }

    .btn-secondary {
        background-color: #64748b;
        color: white;
    }

        .btn-secondary:hover {
            background-color: #475569;
        }

    .target-cell {
        cursor: pointer;
    }

        .target-cell:disabled {
            cursor: default;
        }
    /* Cell status colors */
    .cell-ship {
        background-color: #e0f2fe;
    }
    /* Own ship hit (keep ocean bg so ship sprite stays visible under red cross) */
    .cell-own-hit {
        background-color: rgba(239, 68, 68, 0.2);
    }
    /* Opponent hit (red) */
    .cell-hit {
        background-color: #ef4444;
        color: #fff;
    }
    /* Miss (gray dot) */
    .cell-miss {
        background-color: #94a3b8;
        color: #334155;
    }
</style>

@code {
    [Parameter] public string RoomCode { get; set; } = string.Empty;
    [SupplyParameterFromQuery] public bool Host { get; set; }

    private Board myBoard = new();
    private CellState[,] trackingGrid = new CellState[10, 10]; // Shot tracking grid

    private bool isReady = false;
    private bool isBattleStarted = false;
    private bool isMyTurn = false;
    private string statusMessage = "Place your fleet and click \"Ready for Battle!\"";
    private string copyButtonText = "Copy Invite Link";

    // Manual ship placement
    private static readonly Dictionary<int, int> MaxShipsBySize = new()
    {
        { 4, 1 },
        { 3, 2 },
        { 2, 3 },
        { 1, 4 }
    };
    private int? selectedShipSize = 4;
    private ShipOrientation selectedOrientation = ShipOrientation.Horizontal;
    private Point? hoverPoint = null;

    private async Task LeaveGame()    
    {
        // Notify server about leaving the room
        await HubService.LeaveRoomAsync(RoomCode);

        // Redirect player back to the home page
        Navigation.NavigateTo("/");
    }
    protected override async Task OnInitializedAsync()
    {
        myBoard.PlaceFleetRandomly();
        AutoSelectNextShipSize();

        // 1. Ensure client is connected to SignalR (critical when navigating directly via URL)
        bool wasConnectedOnEntry = HubService.IsConnected;
        if (!wasConnectedOnEntry)
        {
            try
            {
                await HubService.StartConnectionAsync("https://battleship-server-api-h7bzc9e0excrcned.polandcentral-01.azurewebsites.net/gamehub");
            }
            catch (Exception ex)
            {
                statusMessage = $"Connection error: {ex.Message}";
                return;
            }
        }

        // 2. Subscribe to events
        HubService.OnPlayerJoined += HandlePlayerJoined;
        HubService.OnGameStarted += HandleGameStarted;
        HubService.OnShotResultReceived += HandleShotResult;
        HubService.OnOpponentDisconnected += HandleOpponentDisconnected;

        // 3. If a guest joined via link (not from Home), join the room on the server
        if (!Host)
        {
            if (wasConnectedOnEntry)
            {
                statusMessage = "Connected! Place your fleet and confirm readiness.";
            }
            else
            {
                statusMessage = "Joining room...";
                bool joined = await HubService.JoinRoomAsync(RoomCode);
                if (joined)
                {
                    statusMessage = "Connected! Place your fleet and confirm readiness.";
                }
                else
                {
                    statusMessage = "Failed to join (room does not exist or is full).";
                }
            }
        }
        else
        {
            statusMessage = "Share the link with a friend and confirm readiness.";
        }
    }
    private async Task CopyInviteLink()
    {
        // Build clean invite link for the second player WITHOUT ?host=true
        var uri = new Uri(Navigation.Uri);
        var baseAddress = uri.GetLeftPart(UriPartial.Path);
        await JS.InvokeVoidAsync("copyToClipboard", baseAddress);

        copyButtonText = "✅ Link copied!";
        await Task.Delay(2500);
        copyButtonText = "Copy Invite Link";
        StateHasChanged();
    }

    private int GetRemainingShips(int size)
    {
        int placed = myBoard.Ships.Count(s => s.Size == size);
        return Math.Max(0, MaxShipsBySize[size] - placed);
    }

    private void AutoSelectNextShipSize()
    {
        if (selectedShipSize.HasValue && GetRemainingShips(selectedShipSize.Value) > 0)
            return;

        foreach (var size in new[] { 4, 3, 2, 1 })
        {
            if (GetRemainingShips(size) > 0)
            {
                selectedShipSize = size;
                return;
            }
        }
        selectedShipSize = null;
    }

    private void SelectShipSize(int size)
    {
        if (GetRemainingShips(size) > 0)
        {
            selectedShipSize = size;
        }
    }

    private void ToggleOrientation()
    {
        selectedOrientation = selectedOrientation == ShipOrientation.Horizontal
            ? ShipOrientation.Vertical
            : ShipOrientation.Horizontal;
    }

    private void ClearFleet()
    {
        if (isReady || isBattleStarted) return;
        myBoard.Clear();
        selectedShipSize = 4;
        statusMessage = "Board cleared. Place your ships on the grid.";
    }

    private void RandomizeFleet()
    {
        if (isReady || isBattleStarted) return;
        myBoard.PlaceFleetRandomly();
        AutoSelectNextShipSize();
        statusMessage = "Fleet placed randomly.";
        StateHasChanged();
    }

    private void OnOwnBoardHover(int x, int y)
    {
        if (isReady || isBattleStarted) return;
        hoverPoint = new Point(x, y);
    }

    private void ClearHover()
    {
        hoverPoint = null;
    }

    private string GetPreviewCssClass(int x, int y)
    {
        if (isReady || isBattleStarted || hoverPoint == null || !selectedShipSize.HasValue)
            return "";

        int size = selectedShipSize.Value;
        if (GetRemainingShips(size) <= 0)
            return "";

        bool isValid = myBoard.CanPlaceShip(size, hoverPoint, selectedOrientation, out var pts);

        // Check if cell (x, y) is part of the ship preview footprint from hoverPoint
        bool inFootprint = false;
        for (int i = 0; i < size; i++)
        {
            int cx = selectedOrientation == ShipOrientation.Horizontal ? hoverPoint.X + i : hoverPoint.X;
            int cy = selectedOrientation == ShipOrientation.Vertical ? hoverPoint.Y + i : hoverPoint.Y;
            if (cx == x && cy == y)
            {
                inFootprint = true;
                break;
            }
        }

        if (!inFootprint) return "";
        return isValid ? "preview-valid" : "preview-invalid";
    }

    private void OnOwnBoardClick(int x, int y)
    {
        if (isReady || isBattleStarted) return;

        var clickedPt = new Point(x, y);

        // If clicking an already placed ship — remove it so it can be repositioned
        if (myBoard.GetCellState(x, y) == CellState.Ship)
        {
            var removed = myBoard.RemoveShipAt(clickedPt);
            if (removed != null)
            {
                selectedShipSize = removed.Size;
                selectedOrientation = removed.Orientation;
                statusMessage = $"Removed: {removed.Name}. Choose a new position.";
            }
            return;
        }

        // Otherwise try to place the selected ship
        if (!selectedShipSize.HasValue || GetRemainingShips(selectedShipSize.Value) <= 0)
        {
            AutoSelectNextShipSize();
            if (!selectedShipSize.HasValue)
            {
                statusMessage = "All ships are already placed! Click \"Ready for Battle!\" or click a ship to move it.";
                return;
            }
        }

        var ship = Board.CreateShipBySize(selectedShipSize.Value);
        if (myBoard.TryPlaceShip(ship, clickedPt, selectedOrientation))
        {
            AutoSelectNextShipSize();
            statusMessage = myBoard.IsFleetComplete()
                ? "All ships placed! Click \"Ready for Battle!\"."
                : $"Placed: {ship.Name}. Ships remaining: {10 - myBoard.Ships.Count}.";
        }
        else
        {
            statusMessage = "Cannot place ship here (out of bounds or touching another ship).";
        }
    }

    private async Task ConfirmReady()
    {
        if (!myBoard.IsFleetComplete())
        {
            statusMessage = "Place all 10 ships first!";
            return;
        }
        isReady = true;
        hoverPoint = null;
        statusMessage = "Waiting for opponent to be ready...";
        var points = myBoard.GetAllOccupiedPoints();
        await HubService.SetReadyAsync(RoomCode, points);
    }

    private void HandlePlayerJoined(string code)
    {
        statusMessage = "Opponent joined the room!";
        InvokeAsync(StateHasChanged);
    }

    private void HandleGameStarted(string firstTurnConnectionId)
    {
        isBattleStarted = true;
       
        isMyTurn = Host;
        statusMessage = isMyTurn ? "Battle started! Your first turn!" : "Battle started! Opponent's turn...";
        InvokeAsync(StateHasChanged);
    }

    private async Task MakeShot(int x, int y)
    {
        if (!isMyTurn) return;
        await HubService.SendShotAsync(RoomCode, new Point(x, y));
    }

    private static string GetEnglishShipName(ShotResultDto result)
    {
        if (result.SunkShipCoordinates is { Count: > 0 } coords)
        {
            return coords.Count switch
            {
                4 => "Carrier",
                3 => "Battleship",
                2 => "Cruiser",
                1 => "Destroyer",
                _ => "ship"
            };
        }

        return result.SunkShipName switch
        {
            "Чотирипалубний" => "Carrier",
            "Трипалубний" => "Battleship",
            "Двопалубний" => "Cruiser",
            "Однопалубний" => "Destroyer",
            null or "" => "ship",
            _ => result.SunkShipName
        };
    }

    private void HandleShotResult(ShotResultDto result)
    {
        // Update tracking grid or own board
        var pt = result.Target;

        if (isMyTurn)
        {
            // This was our shot
            trackingGrid[pt.X, pt.Y] = result.IsHit ? CellState.Hit : CellState.Miss;

            // If ship is sunk — mark all its coordinates as Hit,
            // and automatically mark all surrounding coordinates as Miss
            if (result.IsSunk && result.SunkShipCoordinates != null)
            {
                foreach (var shipPt in result.SunkShipCoordinates)
                {
                    trackingGrid[shipPt.X, shipPt.Y] = CellState.Hit;
                }

                var surrounding = Board.GetSurroundingCoordinates(result.SunkShipCoordinates);
                foreach (var sPt in surrounding)
                {
                    if (trackingGrid[sPt.X, sPt.Y] == CellState.Empty)
                    {
                        trackingGrid[sPt.X, sPt.Y] = CellState.Miss;
                    }
                }
            }

            if (result.IsGameOver)
            {
                statusMessage = "🏆 Congratulations! You destroyed the entire enemy fleet and won!";
                isMyTurn = false;
            }
            else
            {
                isMyTurn = result.IsHit; // If hit — shoot again, if miss — turn passes
                statusMessage = result.IsHit
                    ? (result.IsSunk ? $"🔥 Sunk: {GetEnglishShipName(result)}! Shoot again." : "🎯 Hit! Shoot again.")
                    : "🌊 Miss. Opponent's turn.";
            }
        }
        else
        {
            // Opponent fired at our board (process both hits and misses)
            myBoard.ProcessShot(pt);

            if (result.IsGameOver)
            {
                statusMessage = "💀 Your fleet has been destroyed. Defeat.";
                isMyTurn = false;
            }
            else
            {
                isMyTurn = !result.IsHit;
                statusMessage = result.IsHit
                    ? (result.IsSunk ? $"💥 Opponent sunk your {GetEnglishShipName(result)}!" : "💥 Opponent hit your ship!")
                    : "🛡️ Opponent missed. Your turn!";
            }
        }

        InvokeAsync(StateHasChanged);
    }

    private void HandleOpponentDisconnected()
    {
        statusMessage = "Opponent left the game. Match ended.";
        isBattleStarted = false;
        InvokeAsync(StateHasChanged);
    }

    private (Ship ship, int segmentIndex)? GetShipSegmentAt(int x, int y)
    {
        foreach (var ship in myBoard.Ships)
        {
            for (int i = 0; i < ship.OccupiedPoints.Count; i++)
            {
                var pt = ship.OccupiedPoints[i];
                if (pt.X == x && pt.Y == y)
                {
                    return (ship, i);
                }
            }
        }
        return null;
    }

    private string GetShipSpriteStyle(Ship ship, int segmentIndex)
    {
        int size = ship.Size;
        double posPercent = size > 1 ? (segmentIndex * 100.0 / (size - 1)) : 0.0;
        string posStr = posPercent.ToString("0.####", System.Globalization.CultureInfo.InvariantCulture);
        return $"background-image: url('images/ships/ship{size}.png'); background-size: 100% {size * 100}%; background-position: 0% {posStr}%;";
    }

    private string GetCellCssClass(CellState state, bool isOwnBoard) => state switch
    {
        CellState.Ship when isOwnBoard => "cell-ship",
        CellState.Hit when isOwnBoard => "cell-own-hit",
        CellState.Hit => "cell-hit",
        CellState.Miss => "cell-miss",
        _ => ""
    };

    private string GetCellSymbol(CellState state, bool isOwnBoard) => state switch
    {
        CellState.Ship when isOwnBoard => "■",
        CellState.Hit => "✕",
        CellState.Miss => "•",
        _ => ""
    };

    public void Dispose()
    {
        HubService.OnPlayerJoined -= HandlePlayerJoined;
        HubService.OnGameStarted -= HandleGameStarted;
        HubService.OnShotResultReceived -= HandleShotResult;
        HubService.OnOpponentDisconnected -= HandleOpponentDisconnected;
    }
}
